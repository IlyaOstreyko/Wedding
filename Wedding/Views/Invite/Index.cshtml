@model Wedding.ViewModel.InvitePageVm
@{
    Layout = "_Layout";
    ViewData["HideHeader"] = true;
    var weddingDate = new DateTime(2026, 8, 1, 15, 15, 00); // локальное время свадьбы (можете изменить время)
    var weddingDateIso = weddingDate.ToString("o");
}
<div class="frame-wrapper">
    <div class="frame-bg" aria-hidden="true"></div>

    <div class="frame-content">
        <section class="invite-hero">
            <div class="invite-hero-inner container">
                <div class="container survey-section mt-1 mb-1">
                    <div class="wedding-header text-center mb-4">
                        <div class="wedding-subtitle">Свадебное приглашение</div>

                        <h1 class="wedding-title">
                            Дарья <span class="amp">&</span> Илья
                        </h1>

                        <div class="wedding-line"></div>

                        <div class="wedding-date-big">
                            01 · 08 · 2026
                        </div>
                    </div>
                    <div class="invite-card">
                        <div class="invite-card-body">
                            <h5 class="invite-title">Приглашение</h5>
                            <p class="invite-text">
                                Дорогие <span class="guest-name">@Model.GuestName</span>,
                                приглашаем вас разделить с нами счастье нашего свадебного дня
                            </p>
                            <p class="invite-meta">
                                <strong>Дата:</strong>1 августа 2026
                                <br />
                                <strong>В программе:</strong>
                                <br />
                                <strong>10:30</strong> — Церемония в ЗАГСе Центрального района (Минск, ул. М. Богдановича, 17а)
                                <br />
                                <strong>16:00</strong> — Банкет на усадьбе «Экзотика» (Бобруйский р-н, д. Спорное, 30)
                            </p>
                            <div class="small muted">Пожалуйста, заполните опрос ниже — это займёт пару минут.</div>
                        </div>
                    </div>
                </div>
                <div class="container survey-section mt-1 mb-1">
@*                     <h1 class="couple-names">Дарья &amp; Илья</h1>
                    <p class="wedding-date">01.08.2026 — Торжество и праздник</p> *@

                    <div id="countdown" class="countdown" data-target="@weddingDateIso" aria-live="polite">
                        <div class="count-item"><span class="count-value" id="cd-days">00</span><span class="count-label">Дней</span></div>
                        <div class="count-item"><span class="count-value" id="cd-hours">00</span><span class="count-label">Часов</span></div>
                        <div class="count-item"><span class="count-value" id="cd-mins">00</span><span class="count-label">Минут</span></div>
                        <div class="count-item"><span class="count-value" id="cd-secs">00</span><span class="count-label">Секунд</span></div>
                    </div>

                    <p class="hero-note">Мы будем рады видеть вас на нашем празднике. Пожалуйста, ответьте на несколько вопросов — это поможет нам сделать день ещё лучше.</p>

@*                     <div class="hero-actions">
                        <a href="#surveySection" class="btn btn-light btn-lg">Пройти опрос</a>
                        <a href="mailto:" class="btn btn-outline-light btn-lg">Связаться с нами</a>
                    </div> *@
                </div>

                
            </div>
        </section>

        <section id="surveySection" class="container survey-section mt-1 mb-1">
            <div class="survey-header text-center mb-4">
                <h3 class="mb-1">Опрос приглашённого</h3>
                <p class="text-muted">Ответы будут привязаны к вашему приглашению и помогут нам подготовиться</p>
            </div>

            <div class="row">
                <div class="col-lg-8 mx-auto">
                    <form id="inviteSurveyForm" onsubmit="return false;" class="survey-form">
                        <input type="hidden" id="inviteToken" value="@Model.InviteToken" />

                        <div id="questionsContainer" class="questions-container">
                            @for (int i = 0; i < Model.Questions.Count; i++)
                            {
                                var q = Model.Questions[i];
                                <div class="card question-card mb-3" data-index="@i" data-question-id="@q.QuestionId" data-instance="@q.InstanceIndex" role="group" aria-labelledby="qtitle_@i">
                                    <div class="card-body">
                                        <h6 id="qtitle_@i" class="card-title question-title">@q.Text</h6>

                                        <div class="options">
                                            @if (q.IsMultipleChoice)
                                            {
                                                foreach (var opt in q.Options)
                                                {
                                                    var inputId = $"opt_{i}_{opt.Id}";
                                                    <div class="form-check">
                                                        <input class="form-check-input option-checkbox" type="checkbox" id="@inputId" data-option-id="@opt.Id" />
                                                        <label class="form-check-label" for="@inputId">@opt.Text</label>
                                                    </div>
                                                }
                                            }
                                            else
                                            {
                                                foreach (var opt in q.Options)
                                                {
                                                    var inputId = $"opt_{i}_{opt.Id}";
                                                    <div class="form-check">
                                                        <input class="form-check-input option-radio" type="radio" name="q_@i" id="@inputId" data-option-id="@opt.Id" />
                                                        <label class="form-check-label" for="@inputId">@opt.Text</label>
                                                    </div>
                                                }
                                            }
                                        </div>

                                        @if (q.AllowCustomAnswer)
                                        {
                                            <div class="mt-3">
                                                <label class="form-label">Свой ответ</label>
                                                <input type="text" class="form-control custom-answer" placeholder="Ваш ответ" />
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>

                        <div class="d-flex justify-content-between align-items-center mt-4">
                            <div class="text-muted small">
                                Ваш город: <strong>@Model.GuestCity</strong> @if (Model.IsCouple)
                                {
                                    <span class="badge bg-secondary ms-2">Пара</span>
                                }
                            </div>
                            <div>
                                <button id="submitSurveyBtn" class="btn btn-primary btn-lg" type="button" onclick="submitSurvey()">Отправить ответы</button>
                                <a href="~/" class="btn btn-outline-secondary btn-lg ms-2">Отмена</a>
                            </div>
                        </div>
                    </form>

                    <div id="inviteToastHolder" class="position-fixed top-0 end-0 p-3" style="z-index:1080;"></div>
                </div>
            </div>
        </section>
    </div>
</div>


@section Styles {
    <link rel="stylesheet" href="~/css/invite.css" />
}

@section Scripts {
    <script src="~/js/invite-survey.js" defer></script>
    <script src="~/js/invite-countdown.js" defer></script>
}
