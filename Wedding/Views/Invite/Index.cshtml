@using Wedding.Models
@model Wedding.ViewModel.InvitePageVm
@{
    Layout = null; // Отключаем глобальный шаблон полностью

    var weddingDate = new DateTime(2026, 8, 1, 15, 15, 0);
    var weddingDateIso = weddingDate.ToString("o");
    var greeting = Model.IsCouple
    ? "Дорогие"
    : Model.Gender == Gender.Male
        ? "Дорогой"
        : "Дорогая";
    var attendanceText = Model.IsCouple
? "Мы будем на свадьбе"
: "Я буду на свадьбе";
}

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Приглашение на свадьбу Ильи и Дарьи</title>

    <!-- Подключаем шрифты -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500;600&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">

    <!-- Подключаем ваши стили -->
    <link rel="stylesheet" href="~/css/invite.css" />
    <link rel="icon" type="image/png" href="~/logo.png" />
</head>
<body>

    <section class="hero-section">
        <div class="global-background"></div>
        <div class="global-background-overlay"></div>
        <div class="hero-content">
            <div class="hero-subtitle fade-up">wedding day</div>
            <h1 class="hero-title fade-up delay-1">Илья <span>&</span> Дарья</h1>
            <div class="hero-date fade-up delay-2">1 августа 2026</div>
            <a href="#invitation" class="hero-scroll fade-up delay-3">↓</a>
        </div>
    </section>

    <section id="invitation" class="section editorial-section">
        <div class="container-custom">
            <div class="glass-card fade-up">
                <div class="section-label">Приглашение</div>
                <h2 class="editorial-title">@greeting @Model.GuestName</h2>
                <p class="editorial-text">Мы будем счастливы разделить с вами один из самых важных и трогательных дней нашей жизни.</p>
                <p class="editorial-text">Приглашаем вас стать частью нашего свадебного торжества, наполненного любовью, теплом и счастливыми моментами.</p>
                <p class="editorial-text">
                    Будем признательны, если девушки воздержатся от нарядов преимущественно белого цвета. Пусть в этот вечер он будет только на невесте.
                </p>
            </div>
        </div>
    </section>

    <!-- ... ОСТАЛЬНЫЕ ВАШИ СЕКЦИИ (Timeline, Countdown, Survey, Final) ОСТАЮТСЯ БЕЗ ИЗМЕНЕНИЙ ... -->
    <section class="section attendance-section">

        <div class="container-custom">

            <div class="glass-card attendance-card fade-up">

                <div class="section-label">
                    Илья <span>&</span> Дарья
                </div>

                <h2 class="editorial-title">
                    Подтверждение присутствия
                </h2>

                <p class="attendance-description">
                    Вы можете в любой момент подтвердить или отменить своё присутствие.
                    Изменение сохраняется автоматически и не зависит от заполнения анкеты.
                </p>

                <label class="attendance-toggle">

                    <input type="checkbox"
                           id="attendanceCheckbox"
                    @(Model.IsConfirmed ? "checked" : "") />

                    <span class="attendance-toggle-ui"></span>

                    <span class="attendance-toggle-text">
                        @attendanceText
                    </span>

                </label>

            </div>

        </div>

    </section>

    <section class="section timeline-section">

        <div class="container-custom">

            <div class="section-heading fade-up">
                План дня
            </div>

            <div class="timeline">

                <div class="timeline-item fade-up">

                    <div class="timeline-time">
                        10:30
                    </div>

                    <div class="timeline-content">
                        <h3>Церемония</h3>

                        <p>
                            ЗАГС Центрального района
                        </p>

                        <div class="timeline-location">
                            Минск, ул. М. Богдановича, 17а
                        </div>
                    </div>

                </div>

                <div class="timeline-item fade-up delay-1">

                    <div class="timeline-time">
                        16:00
                    </div>

                    <div class="timeline-content">
                        <h3>Банкет</h3>

                        <p>
                            Усадьба «Экзотика»
                        </p>

                        <div class="timeline-location">
                            Бобруйский район, д. Спорное, 30
                        </div>
                    </div>

                </div>

            </div>

        </div>

    </section>

    <section class="section countdown-section">

        <div class="container-custom text-center">

            <div class="section-heading fade-up">
                До свадьбы осталось
            </div>

            <div id="countdown"
                 class="countdown fade-up delay-1"
                 data-target="@weddingDateIso">

                <div class="count-item">
                    <div class="count-value" id="cd-days">00</div>
                    <div class="count-label">дней</div>
                </div>

                <div class="count-item">
                    <div class="count-value" id="cd-hours">00</div>
                    <div class="count-label">часов</div>
                </div>

                <div class="count-item">
                    <div class="count-value" id="cd-mins">00</div>
                    <div class="count-label">минут</div>
                </div>

                <div class="count-item">
                    <div class="count-value" id="cd-secs">00</div>
                    <div class="count-label">секунд</div>
                </div>

            </div>

        </div>

    </section>

    <section class="section survey-section" id="surveySection">

        <div class="container-custom">

            <div class="survey-wrapper glass-card">

                <div class="survey-header">

                    <div class="section-label">
                        Илья <span>&</span> Дарья
                    </div>

                    <p class="survey-description">
                        Пожалуйста, ответьте на несколько вопросов.
                        Это поможет нам лучше подготовить праздник.
                    </p>
                    @if (Model.IsCouple)
                    {
                        <p class="survey-note">
                            Парам отвечать вместе и с одного устройства
                        </p>
                    }

                </div>


                <form id="inviteSurveyForm"
                      class="survey-form"
                      onsubmit="return false;">

                    <input type="hidden"
                           id="inviteToken"
                           value="@Model.InviteToken" />

                    <div class="survey-progress">

                        <div class="survey-progress-bar"
                             id="surveyProgressBar"></div>

                    </div>

                    <div class="survey-steps">

                        @for (int i = 0; i < Model.Questions.Count; i++)
                        {
                            var q = Model.Questions[i];

                            <div class="survey-step @(i == 0 ? "active" : "")"
                                 data-step="@i"
                                 data-question-id="@q.QuestionId">

                                <div class="step-counter">
                                    Вопрос @(i + 1) из @Model.Questions.Count
                                </div>

                                <h3 class="survey-question">
                                    @q.Text
                                </h3>

                                <div class="survey-options">

                                    @foreach (var opt in q.Options)
                                    {
                                        var inputId = $"opt_{q.QuestionId}_{opt.Id}";

                                        <label class="option-card" for="@inputId">

                                            <input type="checkbox"
                                                   class="option-checkbox"
                                                   id="@inputId"
                                                   data-option-id="@opt.Id" />

                                            <span class="custom-check"></span>

                                            <span class="option-text">
                                                @opt.Text
                                            </span>

                                        </label>
                                    }

                                </div>

                                @if (q.AllowCustomAnswer)
                                {
                                    <div class="custom-answer-block">

                                        <label class="custom-answer-label" for="customAnswer_@i">
                                            Ваш вариант
                                        </label>

                                        <input type="text"
                                               id="customAnswer_@i"
                                               class="custom-answer"
                                               placeholder="Введите ваш ответ" />

                                    </div>
                                }

                                <div class="survey-navigation">

                                    @if (i > 0)
                                    {
                                        <button type="button"
                                                class="btn-secondary"
                                                onclick="prevStep()">
                                            Назад
                                        </button>
                                    }

                                    @if (i < Model.Questions.Count - 1)
                                    {
                                        <button type="button"
                                                class="btn-primary-custom"
                                                onclick="nextStep()">
                                            Далее
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button"
                                                id="submitSurveyBtn"
                                                class="btn-primary-custom"
                                                onclick="submitSurvey()">
                                            Отправить ответы
                                        </button>
                                    }

                                </div>

                            </div>
                        }

                    </div>

                </form>

            </div>

        </div>

    </section>

    <section class="section final-section">

        <div class="container-custom text-center">

            <div class="final-content fade-up">

                <div class="final-subtitle">
                    Спасибо
                </div>

                <h2 class="final-title">
                    Ждём вас
                </h2>

                <p class="final-text">
                    С любовью,<br />
                    Илья & Дарья
                </p>

            </div>

        </div>

    </section>

    <div id="inviteToastHolder" class="toast-holder"></div>

    <!-- Подключаем скрипты перед закрывающим тегом body -->
    <script src="~/js/invite-countdown.js"></script>
    <script src="~/js/invite.js"></script>
</body>
</html>