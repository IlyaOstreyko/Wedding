@{
    Layout = "_Layout";
}
@* Подключите Bootstrap Icons в _Layout или здесь *@

<div class="container mt-4">
    <h2>Управление вопросами</h2>

    <div class="card p-3 mt-3">
        <h4>Добавить вопрос</h4>

        <div class="mb-3">
            <input id="questionText" class="form-control" placeholder="Текст вопроса" />
        </div>

        <div class="form-check mb-2">
            <input id="isMultiple" type="checkbox" class="form-check-input" />
            <label class="form-check-label">Множественный выбор</label>
        </div>

        <div class="form-check mb-3">
            <input id="allowCustom" type="checkbox" class="form-check-input" />
            <label class="form-check-label">Разрешить свой ответ</label>
        </div>
        <div class="form-check mb-3">
            <input id="outOf" type="checkbox" class="form-check-input" />
            <label class="form-check-label">Для иногородних</label>
        </div>
        <div class="form-check mb-3">
            <input id="couple" type="checkbox" class="form-check-input" />
            <label class="form-check-label">Удваивать для пар</label>
        </div>

        <hr />

        <h5>Варианты ответов</h5>
        <div id="optionsList"></div>

        <div class="mt-2">
            <button type="button" class="btn btn-outline-secondary" onclick="addOption()">+ Добавить вариант</button>
        </div>

        <div class="mt-3">
            <button type="button" class="btn btn-primary" onclick="saveQuestion()">Сохранить вопрос</button>
        </div>
    </div>

    <div class="card p-3 mt-4">
        <h4>Список вопросов</h4>
        <div id="questionsList" class="mt-2"></div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.js" defer></script>
    <script src="~/js/questions.js"></script>
}
