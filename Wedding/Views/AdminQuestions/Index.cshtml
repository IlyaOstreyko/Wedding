@{
    Layout = "_Layout";
}

<div class="container mt-4">
    <h2>Управление вопросами</h2>

    <button class="btn btn-success" onclick="openCreateQuestionModal()">
        Добавить вопрос
    </button>
</div>

<div class="card p-3 mt-4">
    <h4>Список вопросов</h4>
    <div id="questionsList" class="mt-2"></div>
</div>

<div class="modal fade" id="questionModal">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">

            <div class="modal-header">
                <h5 id="questionModalTitle">Вопрос</h5>
            </div>

            <div class="modal-body">

                <input type="hidden" id="questionId">

                <input id="modalQuestionText" class="form-control mb-2" placeholder="Текст">

                <div class="form-check">
                    <input id="modalIsMultiple" type="checkbox" class="form-check-input">
                    <label class="form-check-label">Множественный выбор</label>
                </div>

                <div class="form-check">
                    <input id="modalAllowCustom" type="checkbox" class="form-check-input">
                    <label class="form-check-label">Разрешить свой ответ</label>
                </div>

                <div class="form-check">
                    <input id="modalOutOf" type="checkbox" class="form-check-input">
                    <label class="form-check-label">Для иногородних</label>
                </div>

                <hr />

                <button class="btn btn-sm btn-secondary" onclick="addModalOption()">+ Добавить вариант</button>

                <div id="modalOptionsList"></div>

            </div>

            <div class="modal-footer">
                <button class="btn btn-primary" onclick="saveQuestionModal()">Сохранить</button>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" />
    <script src="~/js/questions.js"></script>
}
