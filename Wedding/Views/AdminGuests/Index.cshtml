@{
    Layout = "_Layout";
}
@using Wedding.Models
@model IEnumerable<Guest>

<div class="container mt-4">

    <div class="row justify-content-center">
        <div class="col-lg-12 col-12">

            <div class="d-flex align-items-center justify-content-between mb-3">
                <h2 class="mb-0">Управление гостями</h2>
            </div>

            <button class="btn btn-success mb-3 w-100" onclick="openAddGuestModal()">
                <i class="bi bi-plus-lg"></i> Добавить гостя
            </button>

            <!-- СТАТИСТИКА -->
            <div class="card shadow-sm mb-3 w-100">
                <div class="card-body">
                    <h5 class="card-title">Статистика</h5>
                    <div id="stats" class="small"></div>
                </div>
            </div>

            <!-- ЛЕГЕНДА -->
            <div class="card shadow-sm mb-3 w-100">
                <div class="card-body">
                    <h6 class="card-title">Легенда</h6>
                    <div id="legend" class="d-flex flex-wrap gap-3 align-items-center"></div>
                </div>
            </div>

            <!-- ПОИСК -->
            <input id="search"
                   class="form-control form-control-sm mb-3 w-100"
                   placeholder="Поиск: имя, город или email" />

            <!-- ТАБЛИЦА -->
            <div class="card shadow-sm w-100">
                <div class="card-body">
                    <h5 class="card-title">Список гостей</h5>

                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Имя</th>
                                    <th>Город</th>
                                    <th class="text-center">Пара</th>
                                    <th class="text-center">Подтверждение</th>
                                    <th class="text-end" style="width:150px;">Действия</th>
                                </tr>
                            </thead>
                            <tbody id="guestList"></tbody>
                        </table>
                    </div>

                </div>
            </div>

        </div>
    </div>
</div>

<!-- Toasts holder (для уведомлений) -->
<div id="guestsToastHolder" aria-live="polite" aria-atomic="true" class="position-fixed top-0 end-0 p-3" style="z-index:1080;"></div>

<style>
    /* Небольшие стили для легенды и свотчей */
    .legend-swatch {
        width: 28px;
        height: 18px;
        display: inline-block;
        border-radius: 4px;
        box-shadow: 0 0 0 1px rgba(0,0,0,0.06) inset;
    }
    /* Уменьшаем высоту кнопок в таблице для компактности */
    table.table .btn-sm {
        padding: .25rem .4rem;
        font-size: .85rem;
    }
</style>
<div class="modal fade" id="guestModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="guestModalTitle">
                    Добавить гостя
                </h5>
                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">

                <input type="hidden" id="guestId" />

                <div class="mb-3">
                    <input id="nameGuest"
                           class="form-control"
                           placeholder="Имя">
                </div>

                <div class="mb-3">
                    <input id="cityGuest"
                           class="form-control"
                           placeholder="Город"
                           list="cityList">
                </div>

                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <div class="form-check">
                            <input id="youngGuest"
                                   type="checkbox"
                                   class="form-check-input">
                            <label class="form-check-label">
                                Молодёжь
                            </label>
                        </div>
                    </div>

                    <div class="col-6">
                        <div class="form-check">
                            <input id="couple"
                                   type="checkbox"
                                   class="form-check-input">
                            <label class="form-check-label">
                                Пара
                            </label>
                        </div>
                    </div>
                </div>

                <div id="genderBlock" class="mb-3">
                    <label class="form-label fw-bold">Пол</label>

                    <div class="d-flex gap-3">
                        <div class="form-check">
                            <input class="form-check-input"
                                   type="radio"
                                   name="gender"
                                   id="genderMale"
                                   value="Male">
                            <label class="form-check-label">
                                Мужской
                            </label>
                        </div>

                        <div class="form-check">
                            <input class="form-check-input"
                                   type="radio"
                                   name="gender"
                                   id="genderFemale"
                                   value="Female">
                            <label class="form-check-label">
                                Женский
                            </label>
                        </div>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Сторона</label>

                    <div class="d-flex gap-3">
                        <div class="form-check">
                            <input class="form-check-input"
                                   type="radio"
                                   name="side"
                                   id="sideHusband"
                                   value="husband">
                            <label class="form-check-label">
                                Со стороны мужа
                            </label>
                        </div>

                        <div class="form-check">
                            <input class="form-check-input"
                                   type="radio"
                                   name="side"
                                   id="sideWife"
                                   value="wife">
                            <label class="form-check-label">
                                Со стороны жены
                            </label>
                        </div>
                    </div>
                </div>

                <div>
                    <label class="form-label fw-bold">Тип гостя</label>

                    <div class="d-flex gap-3">
                        <div class="form-check">
                            <input class="form-check-input"
                                   type="radio"
                                   name="relation"
                                   id="relRelative"
                                   value="relative">
                            <label class="form-check-label">
                                Родственник
                            </label>
                        </div>

                        <div class="form-check">
                            <input class="form-check-input"
                                   type="radio"
                                   name="relation"
                                   id="relFriend"
                                   value="friend">
                            <label class="form-check-label">
                                Друг
                            </label>
                        </div>
                    </div>
                </div>

            </div>

            <div class="modal-footer">
                <button class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    Отмена
                </button>

                <button class="btn btn-primary"
                        onclick="saveGuest()">
                    Сохранить
                </button>
            </div>

        </div>
    </div>
</div>
@section Scripts {
    <script src="~/js/guests.js"></script>
}
