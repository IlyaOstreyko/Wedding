@{
    Layout = "_Layout";
}
<div class="container mt-5 text-center">
    <h3>Доступ ограничен</h3>

    <button class="btn btn-primary mt-3" onclick="openPasswordModal()">
        Ввести пароль
    </button>
</div>

<div class="modal" id="passwordModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content p-3">
            <h5>Введите пароль</h5>

            <input type="password" id="adminPassword" class="form-control mt-2">

            <button class="btn btn-success mt-3" onclick="checkPassword()">
                Войти
            </button>
        </div>
    </div>
</div>
@section Scripts {
    <script src="~/js/admin-auth.js"></script>
}
