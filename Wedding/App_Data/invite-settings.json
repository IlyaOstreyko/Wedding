  "Paragraph1": "\u041C\u044B \u0431\u0443\u0434\u0435\u043C \u0441\u0447\u0430\u0441\u0442\u043B\u0438\u0432\u044B \u0440\u0430\u0437\u0434\u0435\u043B\u0438\u0442\u044C \u0441 \u0432\u0430\u043C\u0438 \u043E\u0434\u0438\u043D \u0438\u0437 \u0441\u0430\u043C\u044B\u0445 \u0432\u0430\u0436\u043D\u044B\u0445 \u0438 \u0442\u0440\u043E\u0433\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u0445 \u0434\u043D\u0435\u0439 \u043D\u0430\u0448\u0435\u0439 \u0436\u0438\u0437\u043D\u0438.",
  "Paragraph2": "\u041F\u0440\u0438\u0433\u043B\u0430\u0448\u0430\u0435\u043C \u0432\u0430\u0441 \u0441\u0442\u0430\u0442\u044C \u0447\u0430\u0441\u0442\u044C\u044E \u043D\u0430\u0448\u0435\u0433\u043E \u0441\u0432\u0430\u0434\u0435\u0431\u043D\u043E\u0433\u043E \u0442\u043E\u0440\u0436\u0435\u0441\u0442\u0432\u0430, \u043D\u0430\u043F\u043E\u043B\u043D\u0435\u043D\u043D\u043E\u0433\u043E \u043B\u044E\u0431\u043E\u0432\u044C\u044E, \u0442\u0435\u043F\u043B\u043E\u043C \u0438 \u0441\u0447\u0430\u0441\u0442\u043B\u0438\u0432\u044B\u043C\u0438 \u043C\u043E\u043C\u0435\u043D\u0442\u0430\u043C\u0438.",
  "Paragraph3": "\u0411\u0443\u0434\u0435\u043C \u043F\u0440\u0438\u0437\u043D\u0430\u0442\u0435\u043B\u044C\u043D\u044B, \u0435\u0441\u043B\u0438 \u0434\u0435\u0432\u0443\u0448\u043A\u0438 \u0432\u043E\u0437\u0434\u0435\u0440\u0436\u0430\u0442\u0441\u044F \u043E\u0442 \u043D\u0430\u0440\u044F\u0434\u043E\u0432 \u043F\u0440\u0435\u0438\u043C\u0443\u0449\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E \u0431\u0435\u043B\u043E\u0433\u043E \u0446\u0432\u0435\u0442\u0430. \u041F\u0443\u0441\u0442\u044C \u0432 \u044D\u0442\u043E\u0442 \u0432\u0435\u0447\u0435\u0440 \u043E\u043D \u0431\u0443\u0434\u0435\u0442 \u0442\u043E\u043B\u044C\u043A\u043E \u043D\u0430 \u043D\u0435\u0432\u0435\u0441\u0442\u0435.",
  "Paragraph4": "\u0412\u043C\u0435\u0441\u0442\u043E \u0431\u0443\u043A\u0435\u0442\u043E\u0432 \u043C\u043E\u0436\u0435\u0442\u0435 \u043F\u043E\u0434\u0430\u0440\u0438\u0442\u044C \u043D\u0430\u043C \u0431\u0443\u0442\u044B\u043B\u043A\u0443 \u0432\u0430\u0448\u0435\u0433\u043E \u043B\u044E\u0431\u0438\u043C\u043E\u0433\u043E \u043D\u0430\u043F\u0438\u0442\u043A\u0430.",
